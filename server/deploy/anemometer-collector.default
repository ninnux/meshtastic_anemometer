# Configurazione di anemometer-collector.
# Contiene il token: il file deve restare leggibile solo da root e dal gruppo anemometer.
# Dopo una modifica: service anemometer-collector restart

# URL e credenziali di InfluxDB v2. Con INFLUX_URL vuoto i dati finiscono solo nel log.
INFLUX_URL=""
INFLUX_TOKEN=""
INFLUX_ORG="meteo_org"
INFLUX_BUCKET="anemometri"

# Chiavi delle stazioni: nome:chiave,nome:chiave. Il nome e' NODE_NAME, la chiave e' la
# stessa di secrets.h nel firmware (openssl rand -hex 32). Senza chiavi ogni messaggio
# viene rifiutato.
STATION_KEYS=""

# Indirizzo e porta UDP di ascolto del server CoAP
COAP_BIND="::"
COAP_PORT="5683"

# Indirizzo HTTP per lo storico della webapp (GET /api/history?station=nome).
# Solo locale: nginx lo pubblica su /api/. Vuoto = disattivato. Serve INFLUX_URL.
HTTP_ADDR="127.0.0.1:8080"
