#!/bin/sh
### BEGIN INIT INFO
# Provides:          anemometer-collector
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Ricevitore CoAP della stazione anemometrica
### END INIT INFO

PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=anemometer-collector
DESC="ricevitore CoAP anemometro"
DAEMON=/usr/local/bin/$NAME
PIDFILE=/run/$NAME.pid
USER_NAME=anemometer
LOG_FILE=/var/log/$NAME/collector.log
STATE_FILE=/var/lib/$NAME/counters.json

[ -x "$DAEMON" ] || exit 0

# Le variabili passano dall'ambiente: sulla riga di comando il token sarebbe visibile con ps
if [ -r "/etc/default/$NAME" ]; then
	set -a
	. "/etc/default/$NAME"
	set +a
fi
export LOG_FILE STATE_FILE

. /lib/lsb/init-functions

do_start() {
	# Il processo si riconosce da pidfile e utente: con --exec un aggiornamento del
	# binario o l'emulazione lo farebbero sembrare già fermo, e lo stop non agirebbe.
	start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
		--pidfile "$PIDFILE" --user "$USER_NAME" --chuid "$USER_NAME" --startas "$DAEMON"
}

do_stop() {
	start-stop-daemon --stop --quiet --retry TERM/15/KILL/5 \
		--pidfile "$PIDFILE" --user "$USER_NAME"
	status=$?
	rm -f "$PIDFILE"
	return $status
}

case "$1" in
	start)
		log_daemon_msg "Avvio $DESC" "$NAME"
		do_start
		log_end_msg $?
		;;
	stop)
		log_daemon_msg "Arresto $DESC" "$NAME"
		do_stop
		case "$?" in
			0|1) log_end_msg 0 ;;
			*) log_end_msg 1 ;;
		esac
		;;
	restart|force-reload)
		log_daemon_msg "Riavvio $DESC" "$NAME"
		do_stop
		case "$?" in
			0|1)
				do_start
				log_end_msg $?
				;;
			*) log_end_msg 1 ;;
		esac
		;;
	status)
		status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
		exit $?
		;;
	*)
		echo "Uso: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
		exit 3
		;;
esac
